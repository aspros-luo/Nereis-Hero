    "rule": "Room count is a budget, not a constraint. Add rooms where a traversal, landmark, loop or meaningful choice needs them; merge empty filler rooms."
  },
  "acceptance": {
    "macro_regions": 14,
    "macro_connections": 24,
    "loops": 5,
    "must_have": [
      "one central multi-exit hub",
      "two or more meaningful vertical shafts",
      "three or more shortcut loops that change return routes",
      "one-way terminal descents",
      "optional hidden routes",
      "distant visible goals",
      "distinct region footprints and room density"
    ],
    "must_not_have": [
      "uniform 1500x900 rooms",
      "long uninterrupted flat corridors",
      "door-to-door room chain without loops",
      "visual-only shortcuts with no traversal effect",
      "graybox rectangles treated as final art"
    ]
  }
