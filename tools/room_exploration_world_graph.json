{
  "schema_version": 1,
  "title": "Nereis Hero — Room-Level Exploration World Graph",
  "status": "design_baseline_not_runtime_verified",
  "branch": "feature/story-map-progression",
  "design_principles": [
    "original world inspired by layered metroidvania exploration",
    "each region contains rooms of varied size and vertical role",
    "macro connections must resolve to concrete room anchors",
    "shortcuts must change route options, not merely add map lines",
    "hidden regions are optional and must not block the main ending route"
  ],
  "room_shape_legend": {
    "compact": "tight room, junction, or landmark chamber",
    "wide": "broad horizontal exploration space",
    "tall": "vertical shaft, layered cavern, or tower"
  },
